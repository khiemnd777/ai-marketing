APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
SESSION_SECRET=
ENCRYPTION_KEY=
DATABASE_URL=postgres://studio:studio@localhost:5432/studio?sslmode=disable
VERTICALS_DIR=./verticals
SESSION_TTL_HOURS=12

# One-time bootstrap command only; do not retain the password after use.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=60
OPENAI_INPUT_USD_PER_1M=0
OPENAI_OUTPUT_USD_PER_1M=0

BYTEPLUS_MODELARK_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api
SEEDANCE_MODEL=dreamina-seedance-2-0-260128
SEEDANCE_API_VERSION=v3
SEEDANCE_RESOLUTION=720p
SEEDANCE_DEFAULT_RATIO=9:16
SEEDANCE_WEBHOOK_SECRET=
SEEDANCE_CALLBACK_URL=
SEEDANCE_HTTP_TIMEOUT_SECONDS=30
SEEDANCE_POLL_INTERVAL_SECONDS=15
SEEDANCE_TASK_TIMEOUT_SECONDS=1800
SEEDANCE_USD_PER_SECOND=0

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_REDIRECT_URL=http://localhost:8080/v1/meta/oauth/callback
META_GRAPH_BASE_URL=https://graph.facebook.com
META_DIALOG_BASE_URL=https://www.facebook.com

RENDERER_BASE_URL=http://renderer:8090
RENDERER_SHARED_SECRET=
RENDER_TEMP_DIR=/tmp/studio-renderer
WORKER_TEMP_DIR=/tmp/studio-worker

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
LOG_LEVEL=info
DEMO_MODE=true

# Production deployment/image and restricted admin surfaces.
APP_DOMAIN=
API_IMAGE=
WORKER_IMAGE=
RENDERER_IMAGE=
WEB_IMAGE=
RIVER_BASIC_AUTH_USER=
RIVER_BASIC_AUTH_PASS=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
