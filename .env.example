APP_ENV=development
APP_URL=http://localhost:3300
API_URL=http://localhost:8180
SESSION_SECRET=
ENCRYPTION_KEY=
DATABASE_URL=postgres://studio:studio@localhost:55432/studio?sslmode=disable
VERTICALS_DIR=./verticals
SESSION_TTL_HOURS=12

# Host ports are loopback-only and can be overridden without editing Compose.
STUDIO_WEB_PORT=3300
STUDIO_API_PORT=8180
STUDIO_RENDERER_PORT=8190
STUDIO_RIVER_UI_PORT=8181
STUDIO_POSTGRES_PORT=55432
STUDIO_MINIO_PORT=9100
STUDIO_MINIO_CONSOLE_PORT=9101
STUDIO_GRAFANA_PORT=3301

# OpenAI, Seedance, R2, Meta, renderer endpoint, pricing, and demo/live mode
# are configured per client in Settings > Providers and stored encrypted in PostgreSQL.
RENDERER_INTERNAL_AUTH_SECRET=
RENDER_TEMP_DIR=/tmp/studio-renderer
WORKER_TEMP_DIR=/tmp/studio-worker

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
LOG_LEVEL=info

# Production deployment/image and restricted admin surfaces.
APP_DOMAIN=
API_IMAGE=
WORKER_IMAGE=
RENDERER_IMAGE=
WEB_IMAGE=
RIVER_BASIC_AUTH_USER=
RIVER_BASIC_AUTH_PASS=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
